# Copy to .env.local and fill in. NEVER commit .env.local, never paste these into a chat.
# Supabase → Project Settings → API

# Public by design (the anon key opens only the two public views; every table is locked by RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET — server only
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
# Any long random text (at least 24 characters); protects the scheduled maintenance route
CRON_SECRET=

# Owner alerts (Step 9). Optional: without them the Inbox still works, only email and phone alerts are off.
# Phone alerts: run  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Email alerts: a Resend account and a sending address on a domain you verified there
RESEND_API_KEY=
RESEND_FROM=Leaf Star <alerts@example.com>

# Leave unset on the live site. Set to 1 only on a private test server to open the /dev test pages.
# ALLOW_DEV_PAGES=1

# Only for running the database tests yourself (a local Postgres you can create databases in)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
